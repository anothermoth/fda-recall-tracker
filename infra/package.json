    "destroy": "cdk destroy --force"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "aws-cdk": "^2.1033.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "esbuild": "^0.25.0"
  }
}
