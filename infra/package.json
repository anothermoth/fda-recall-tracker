{
  "name": "@fda-recall-tracker/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK infrastructure for the FDA recall tracker.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
