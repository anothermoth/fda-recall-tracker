# Local development only. Copy to .env and adjust if needed.
# Never commit .env.

# Read/write connection used by migrations, ingest, and local API tests.
DATABASE_URL=postgres://fda:fda@127.0.0.1:5432/fda_recalls

# Optional read-only connection the API can use in a later hardening pass.
# The role is created by db/migrations/002_app_readonly_role.sql.
DATABASE_READONLY_URL=postgres://fda_app_readonly:fda_app_readonly@127.0.0.1:5432/fda_recalls

PORT=3001

# Comma-separated browser origins allowed to call the API. Leave unset
# to reflect the request origin (fine for local development).
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Vite dashboard. Leave empty in local dev to use the Vite proxy at /recalls.
# Set this to the API origin for a production build of the web app.
# VITE_API_BASE_URL=http://127.0.0.1:3001

# Production Lambdas read the database URL from Secrets Manager.
# Local development keeps using DATABASE_URL above.
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:fda-recall-tracker/database-url-AbCdEf

# Optional: archive raw openFDA pages when running ingest locally with AWS credentials.
# ARCHIVE_BUCKET=
# ARCHIVE_PREFIX=ingest/
