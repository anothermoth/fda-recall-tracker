# Local development only. Copy to .env and adjust if needed.
# Never commit .env.

# Read/write connection used by migrations, ingest, and local API tests.
DATABASE_URL=postgres://fda:fda@127.0.0.1:5432/fda_recalls

# Optional read-only connection the API can use in a later hardening pass.
# The role is created by db/migrations/002_app_readonly_role.sql.
DATABASE_READONLY_URL=postgres://fda_app_readonly:fda_app_readonly@127.0.0.1:5432/fda_recalls

PORT=3001
