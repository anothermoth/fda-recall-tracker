{
  "name": "fda-recall-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Track FDA drug recalls from openFDA with Postgres, an Express API, and a React dashboard.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx packages/ingest/src/cli.ts",
    "dev:api": "npm run dev -w @fda-recall-tracker/api",
    "dev:web": "npm run dev -w @fda-recall-tracker/web",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "dotenv": "^16.6.1",
    "concurrently": "^9.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
